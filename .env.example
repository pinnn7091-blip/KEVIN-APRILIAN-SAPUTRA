# GEMINI_API_KEY: Optional default AI Studio env var
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected runtime URL
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Required for Authentication, Database & User Management)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Client-side fallback prefixes (optional if SUPABASE_URL and SUPABASE_ANON_KEY are set on server)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
